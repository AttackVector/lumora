---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');

const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4);
---
<style>
/* Layout: logo + nav bar, hero (image left, text right), plain reading column, screenshot carousel, then list sections. Identity: ink blue and goldenrod, slab headings, paper-like page. */
:root {
  --bg: #f3f5f8;
  --surface: #ffffff;
  --fg: #1b2330;
  --muted: #566274;
  --line: #d8dee8;
  --ink: #213a63;
  --ink-deep: #172a4a;
  --on-ink: #f4f6fa;
  --accent: #e0a526;
  --accent-fg: #1b2330;
  --link: #1f4f9a;
  --font-display: "Bitter", Georgia, "Times New Roman", serif;
  --font-body: "Public Sans", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  --font-mono: "IBM Plex Mono", "DejaVu Sans Mono", monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #12161d; --surface: #1a202a; --fg: #eef1f6; --muted: #9ba6b8; --line: #2a3341;
    --ink: #1b2f52; --ink-deep: #13223d; --on-ink: #f4f6fa;
    --accent: #e8b43c; --accent-fg: #1b2330; --link: #8db8f2;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #12161d; --surface: #1a202a; --fg: #eef1f6; --muted: #9ba6b8; --line: #2a3341;
  --ink: #1b2f52; --ink-deep: #13223d; --on-ink: #f4f6fa;
  --accent: #e8b43c; --accent-fg: #1b2330; --link: #8db8f2;
  color-scheme: dark;
}
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: 17px; line-height: 1.65; }
a { color: var(--link); }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.wrap { max-width: 1100px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }

/* hero */
.hero { background: var(--ink); color: var(--on-ink); position: relative; overflow: hidden; }
.hero .sun { position: absolute; left: -6%; top: 50%; width: 760px; max-width: none; height: 760px; transform: translateY(-50%); pointer-events: none; }
.hero .wrap { position: relative; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 48px; align-items: center; padding-block: 60px; }
.hero h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(32px, 4.6vw, 48px); line-height: 1.12; margin: 0 0 16px; text-wrap: balance; }
.hero p { font-size: clamp(18px, 2.2vw, 21px); line-height: 1.5; margin: 0 0 28px; max-width: 30em; color: #d6deec; }
.actions { display: flex; gap: 12px; flex-wrap: wrap; }
.btn { display: inline-block; padding: 10px 20px; border-radius: 3px; text-decoration: none; font-size: 16.5px; font-weight: 600; border: 2px solid transparent; }
.btn.solid { background: var(--accent); color: var(--accent-fg); }
.btn.solid:hover { filter: brightness(1.07); }
.btn.line { border-color: rgba(244,246,250,.55); color: var(--on-ink); }
.btn.line:hover { background: rgba(255,255,255,.12); }
.laptop { position: relative; width: 100%; max-width: 480px; justify-self: center; filter: drop-shadow(0 18px 24px rgba(0,0,0,.35)); }
.laptop .body { display: block; width: 100%; height: auto; }
.laptop .screen { position: absolute; left: 10.92%; top: 8.82%; width: 77.59%; height: 69.33%; object-fit: cover; border-radius: 2px; }

/* sections */
section { padding-block: 52px; }
h2 { font-family: var(--font-display); font-size: 31px; font-weight: 700; margin: 0 0 14px; line-height: 1.2; text-wrap: balance; }
.col { max-width: 860px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.lede { margin: 0; max-width: 40em; }
.band { background: var(--surface); border-block: 1px solid var(--line); }

/* screenshots */
.shots { margin-top: 26px; }
.shots .frame { min-width: 0; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: var(--surface); box-shadow: 0 6px 20px rgba(23,42,74,.12); }
.shots .frame svg, .shots .frame img { display: block; width: 100%; height: auto; }
.cap { text-align: center; color: var(--muted); font-size: 15px; margin: 14px 0 0; }
/* interactive screenshots */
.shots .frame.stage { position: relative; overflow: visible; }
.stage img { display: block; width: 100%; height: auto; border-radius: 3px; }
.hot { position: absolute; transform: translate(-50%, -50%); background: transparent; border: 0; padding: 0; cursor: pointer; border-radius: 10px; }
.hot::before { content: ""; position: absolute; inset: 0; border-radius: inherit; border: 2px solid var(--accent); box-shadow: 0 0 0 2px rgba(0,0,0,.4), 0 0 14px rgba(224,165,38,.7); animation: hotpulse 1.8s ease-out infinite; }
.hot:hover::before, .hot:focus-visible::before { animation: none; background: rgba(224,165,38,.22); }
@keyframes hotpulse { 0% { transform: scale(.92); opacity: 1; } 70% { transform: scale(1.12); opacity: .25; } 100% { transform: scale(1.12); opacity: 0; } }
.hot .tip { position: absolute; left: 50%; top: calc(100% + 8px); transform: translateX(-50%); white-space: nowrap; background: rgba(15,24,40,.92); color: #fff; font-size: 14px; line-height: 1.3; padding: 5px 10px; border-radius: 4px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 2; }
.hot.right .tip { left: auto; right: 0; transform: none; }
.hot.left .tip { left: 0; transform: none; }
.hot.above .tip { top: auto; bottom: calc(100% + 8px); }
.hot.center .tip { top: 50%; left: 50%; transform: translate(-50%, -50%); }
.hot.quiet::before { animation: none; border-color: transparent; box-shadow: none; }
.hot.quiet:hover::before, .hot.quiet:focus-visible::before { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(0,0,0,.35); background: rgba(224,165,38,.1); }
.steps { display: flex; gap: 8px; justify-content: center; margin-top: 12px; }
.steps button { font: inherit; font-size: 14px; padding: 4px 12px; border-radius: 99px; border: 1px solid var(--line); background: var(--surface); color: var(--fg); cursor: pointer; }
.steps button:hover { border-color: var(--accent); }
.steps button[aria-current="true"] { background: var(--ink); border-color: var(--ink); color: var(--on-ink); }
@media (prefers-reduced-motion: reduce) { .hot::before { animation: none; } }


/* features as a ruled list */
.feat { margin: 26px 0 0; padding: 0; display: grid; }
.feat > div { display: grid; grid-template-columns: minmax(0, 220px) minmax(0, 1fr); gap: 8px 32px; padding: 16px 0; border-top: 1px solid var(--line); }
.feat > div:last-child { border-bottom: 1px solid var(--line); }
.feat dt { font-family: var(--font-display); font-weight: 700; font-size: 19px; }
.feat dd { margin: 0; color: var(--muted); }

/* download */
.dl { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; margin-top: 24px; }
.rel { border: 1px solid var(--line); background: var(--bg); border-radius: 4px; padding: 24px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.rel h3 { margin: 0; font-family: var(--font-display); font-size: 21px; }
.tag { font-family: var(--font-mono); font-size: 13.5px; color: var(--muted); }
.rel p { margin: 0; color: var(--muted); font-size: 16px; }
.rel .btn { align-self: flex-start; margin-top: 8px; }
.req { margin-top: 24px; overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 16px; min-width: 460px; }
th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); }
th { font-weight: 600; color: var(--muted); font-size: 13.5px; letter-spacing: .06em; text-transform: uppercase; }
code { font-family: var(--font-mono); font-size: .92em; }
.note { margin: 16px 0 0; font-size: 15px; color: var(--muted); }

/* news */
.posts { list-style: none; padding: 0; margin: 18px 0 0; }
.posts li { display: flex; gap: 20px; padding: 12px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
.posts time { font-family: var(--font-mono); color: var(--muted); font-size: 14.5px; flex: none; width: 8em; }
.posts a { font-size: 18px; font-weight: 500; }



@media (max-width: 820px) {
  .hero .wrap { grid-template-columns: 1fr; padding-block: 38px; gap: 30px; }
  .hero-text { order: 1; } .laptop { order: 2; max-width: 340px; }
  .dl { grid-template-columns: 1fr; }
  .top nav { justify-content: flex-start; }
  .feat > div { grid-template-columns: 1fr; gap: 2px; }
}
@media (max-width: 520px) {
  .posts li { flex-direction: column; gap: 0; }
  h2 { font-size: 26px; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
body{margin:0}
</style>
<BaseLayout title="Lumora™">
<div id="top" class="hero">
  <svg class="sun" viewBox="0 0 760 760" aria-hidden="true">
    <g fill="none" stroke="#e0a526">
      <circle cx="380" cy="380" r="120" stroke-opacity=".28" stroke-width="2"/>
      <circle cx="380" cy="380" r="200" stroke-opacity=".2" stroke-width="2"/>
      <circle cx="380" cy="380" r="280" stroke-opacity=".14" stroke-width="2"/>
      <circle cx="380" cy="380" r="360" stroke-opacity=".09" stroke-width="2"/>
    </g>
  </svg>
  <div class="wrap">
    <div class="laptop" role="img" aria-label="A laptop running the Lumora desktop">
      <img class="body" src="/laptop.png" alt="" width="348" height="238">
      <img class="screen" src="/desktop-1.png" alt="">
    </div>
    <div class="hero-text">
      <h1>The desktop you already know how to use.</h1>
      <p>Lumora™ is a feature-filled, easy to use Linux distro, with a familiar layout.</p>
      <div class="actions">
        <a class="btn solid" href="#download">Download Version 27</a>
        <a class="btn line" href="#about">Learn more</a>
      </div>
    </div>
  </div>
</div>

<section id="about">
  <div class="col">
    <h2>What is Lumora™?</h2>
    <p class="lede">The word lumora means a "gentle glow/radiance". Lumora™ is a stable, easy to use operating system with a configurable desktop. It is made for people who struggle with switching to Linux, and provides a familiar layout with a top bar, and a dock. It runs well on modern workstations, and *some* older hardware.</p>
  </div>
</section>

<section id="screens" style="padding-top:0">
  <div class="col">
    <h2>Desktop layout</h2>
    <p class="lede">Lumora's desktop layout, with a top bar and a dock. Click the glowing spots in the picture to try it out.</p>
    <div class="shots">
      <div class="frame stage" id="stage">
        <img id="shot" src="shots/screen-1-desktop.jpg" alt="Lumora desktop with a yellow palace wallpaper, a top bar and a dock at the bottom" width="1600" height="900">
      </div>
    </div>
    <p class="cap" id="shotcap" aria-live="polite">The Lumora desktop. Click Activities in the top left to see your open windows, or the leaf in the dock to show all apps.</p>
    <div class="steps" id="steps" role="group" aria-label="Choose a screenshot"></div>
  </div>
</section>

<section id="features" class="band">
  <div class="col">
    <h2>Features</h2>
    <dl class="feat">
      <div><dt>Familiar desktop</dt><dd>Panels, a dock, and window buttons where you expect them.</dd></div>
      <div><dt>Snappy</dt><dd>While working, the experience is fast, and snappy, meaning you won't expect a hiccup while you are focused. (your mileage may vary).</dd></div>
      <div><dt>Stable releases</dt><dd>Based on a world class trusted Linux distro (Ubuntu), which will get 5 years of security updates, and software updates.</dd></div>
      <div><dt>App/Game Support</dt><dd>Lumora™ comes with WINE, and Steam preinstalled, meaning using your Windows™ apps will be easy. If your Windows™ apps don't work, try searching for Lumora Alternatives! (Office -> LibreOffice)</dd></div>
      <div><dt>Software included</dt><dd>Firefox, Thunderbird, LibreOffice, plus Bazaar, a software center with thousands of extra apps.</dd></div>
      <div><dt>Independent and private</dt><dd>Built by a high school Linux enthusiast who wanted a friendlier way into Linux. No tracking, no ads, and no account needed to download.</dd></div>
    </dl>
  </div>
</section>

<section id="download">
  <div class="col">
    <h2>Download</h2>
    <p class="lede">Write the image to a USB stick of at least 8 GB or more and try Lumora live before you install it.</p>
    <div class="dl">
      <div class="rel">
        <h3>Lumora™ 27 (10-25 Beta build)</h3>
        <span class="tag">Beta Release (Compiled 25 October) </span>
        <p>Should work with most systems, but compatibility & stability is not guaranteed. Installer needs to be launched via cmd. Check the forum post for more information. Try this release at your own risk. This is a beta release!!! No responsibility goes to the Lumora team if any data is lost.</p>
        <a class="btn solid" href="https://download1585.mediafire.com/mbjb5uc3awggr6rAKcySNiJRxy5jmZMlv5SLvj0fYAXJSoxitQm6ojSghhBNAmyiekF29W00HFOvEuj8WMZre_ZmKZogcGxvKi4OGI6w0N-QxJEGAOrMH8QoHDGs-0NoO0jaJLEQEtSFDX_KHlVUY_tNWFJ79QBet8OPBxV9wmgx/ua7kr013u0e0rl6/lumora-27-beta-10-25-amd64.iso">Click on the link to download. (4.73 GB)</a>
        <a class="btn solid" href="https://lumora-project.tysona.cv/releases/lumora-27-beta-10-25-amd64.iso">Philidelphia Mirror</a>
        <a class="btn solid" href="http://mirror.tech-portal.me/lumora/lumora-27-beta-10-25-amd64.iso">European Mirror</a>
        <p class="note">After downloading, run <code>sha256sum lumora-27-beta-10-25-amd64.iso</code> and check that it matches this checksum:</p>
<p class="note"><code style="word-break: break-all;">77c294b9a18f40c5b637aabb9c33f6d19a199dcdf71bcaf9da5c5cb1342edb4c</code></p>
      </div>
      <div class="rel">
        <h3>Lumora™ 27 (Release) </h3>
        <span class="tag">Supported until 2031</span>
        <p>Coming soon!</p>
        <a class="btn solid" href="#download">Download ISO (? GB)</a>
      </div>
    </div>
    <div class="req">
      <table>
        <thead><tr><th>Minimum</th><th>Recommended</th></tr></thead>
        <tbody>
          <tr><td>Dual Core 64-bit processor</td><td>Quad core, 3 GHz or faster</td></tr>
          <tr><td>4 GB RAM</td><td>8+ GB RAM</td></tr>
          <tr><td>20 GB disk space</td><td>128 GB disk space</td></tr>
        </tbody>
      </table>
    </div>
    <p class="note">After downloading, run <code>sha256sum lumora-XX-XXXXXX-amd64.iso</code> and compare the result with the checksum on the release page.</p>
  </div>
</section>

<section id="news" class="band">
  <div class="col">
    <h2>Updates</h2>
    <ul class="posts">
      {latestPosts.map(post => (
        <li>
          <time datetime={post.pubDate}>{new Date(post.data.pubDate).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
          })}</time>
          <a href={`/posts/${post.id}`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
    <p style="margin:18px 0 0"><a href="/" style="font-weight:600">All updates</a></p>
  </div>
</section>

<section id="support">
  <div class="col">
    <h2>Support</h2>
    <p class="lede">Start with the documentation, then ask in the forum or the chat room. Most questions get an answer within a day. Report bugs in the issue tracker, and search it first in case someone already has.</p>
  </div>
</section>

<section id="involved" style="padding-top:0">
  <div class="col">
    <h2>Get involved</h2>
    <p class="lede">You do not need to write code to help. Testing releases, translating, writing documentation and drawing wallpapers all make a difference. Join the discord server to help (https://discord.gg/73hWZujgpW)</p>
  </div>
</section>

<section id="funding" class="band">
  <div class="col">
    <h2>Funding</h2>
    <p class="lede">Lumora™ is free. Donations pay for development, better hardware, and a yearly report shows where the money went. Donations will come soon</p>
  </div>
</section>
</BaseLayout>