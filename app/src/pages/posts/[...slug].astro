---
import { getCollection, render } from 'astro:content'; // 1. Import render directly from astro:content
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  // Sort posts chronologically (oldest to newest)
  allPosts.sort((a, b) => new Date(a.data.pubDate) - new Date(b.data.pubDate));

  return allPosts.map((post, index) => {
    const prevPost = index > 0 ? allPosts[index - 1] : null;
    const nextPost = index < allPosts.length - 1 ? allPosts[index + 1] : null;
    
    return {
      params: { slug: post.id }, // Uses the unique file ID as the slug parameter
      props: { 
        post,
        prevPost: prevPost ? { url: `/posts/${prevPost.id}`, title: prevPost.data.title } : null,
        nextPost: nextPost ? { url: `/posts/${nextPost.id}`, title: nextPost.data.title } : null
      },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;

// 2. Pass the post object into the imported render function
const { Content } = await render(post); 
---

<BlogPostLayout frontmatter={post.data} prevPost={prevPost} nextPost={nextPost}>
  <Content />
</BlogPostLayout>
