---
import { Image } from 'astro:assets';
import screen1 from '../assets/screen-1-desktop.jpg';
---
<style>
.col { max-width: 860px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.lede { margin: 0; max-width: 40em; }
.shots { margin-top: 26px; }
.shots .frame { min-width: 0; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: var(--surface); box-shadow: 0 6px 20px rgba(23,42,74,.12); }
.shots .frame svg, .shots .frame img { display: block; width: 100%; height: auto; }
.cap { text-align: center; color: var(--muted); font-size: 15px; margin: 14px 0 0; }
.steps { display: flex; gap: 8px; justify-content: center; margin-top: 12px; margin-bottom: 12px;}
.steps button { font: inherit; font-size: 14px; padding: 4px 12px; border-radius: 99px; border: 1px solid var(--line); background: var(--surface); color: var(--fg); cursor: pointer; }
.steps button:hover { border-color: var(--accent); }
.steps button[aria-current="true"] { background: var(--ink); border-color: var(--ink); color: var(--on-ink); }

.shots .frame.stage { position: relative; overflow: visible; }
.stage img { display: block; width: 100%; height: auto; border-radius: 3px; }
.hot { position: absolute; transform: translate(-50%, -50%); background: transparent; border: 0; padding: 0; cursor: pointer; border-radius: 10px; }
.hot::before { content: ""; position: absolute; inset: 0; border-radius: inherit; border: 2px solid var(--accent); box-shadow: 0 0 0 2px rgba(0,0,0,.4), 0 0 14px rgba(224,165,38,.7); animation: hotpulse 1.8s ease-out infinite; }
.hot:hover::before, .hot:focus-visible::before { animation: none; background: rgba(224,165,38,.22); }
@keyframes hotpulse { 0% { transform: scale(.92); opacity: 1; } 70% { transform: scale(1.12); opacity: .25; } 100% { transform: scale(1.12); opacity: 0; } }
.hot .tip { position: absolute; left: 50%; top: calc(100% + 8px); transform: translateX(-50%); white-space: nowrap; background: rgba(15,24,40,.92); color: #fff; font-size: 14px; line-height: 1.3; padding: 5px 10px; border-radius: 4px; opacity: 0; pointer-events: none; transition: opacity .15s; z-index: 2; }
.hot.right .tip { left: auto; right: 0; transform: none; }
.hot.left .tip { left: 0; transform: none; }
.hot.above .tip { top: auto; bottom: calc(100% + 8px); }
.hot.center .tip { top: 50%; left: 50%; transform: translate(-50%, -50%); }
.hot.quiet::before { animation: none; border-color: transparent; box-shadow: none; }
.hot.quiet:hover::before, .hot.quiet:focus-visible::before { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(0,0,0,.35); background: rgba(224,165,38,.1); }
.steps { display: flex; gap: 8px; justify-content: center; margin-top: 12px; }
.steps button { font: inherit; font-size: 14px; padding: 4px 12px; border-radius: 99px; border: 1px solid var(--line); background: var(--surface); color: var(--fg); cursor: pointer; }
.steps button:hover { border-color: var(--accent); }
.steps button[aria-current="true"] { background: var(--ink); border-color: var(--ink); color: var(--on-ink); }
@media (prefers-reduced-motion: reduce) { .hot::before { animation: none; } }
</style>
<section id="screens" style="padding-top:0">
  <div class="col">
    <h2>Try Lumora's layout!</h2>
    <p class="lede">Lumora's desktop layout. Click the glowing spots in the picture to try it out. For a more in-depth experience, try the beta!</p>
    <div class="shots">
      <div class="frame stage" id="stage">
        <Image id="shot" src={screen1} alt="Lumora desktop with a yellow palace wallpaper, a top bar and a dock at the bottom" width="1600" height="900" loading="lazy" fetchpriority="high" />
      </div>
    </div>
    <p class="cap" id="shotcap" aria-live="polite">The Lumora desktop. Click Activities in the top left to see your open windows, or the leaf in the dock to show all apps.</p>
    <div class="steps" id="steps" role="group" aria-label="Choose a screenshot"></div>
  </div>
</section>
<span id="resolver"></span>
<script>
(function () {
  const resolver = document.getElementById("resolver"); // used to automatically add astro isolation data attributes
if(!resolver) return;
  
  const astroAttr = Array.from(resolver.attributes)
    .find(attr => attr.name.startsWith('data-astro-cid'))?.name;
    console.log(astroAttr)
  var W = 1781, H = 1002; /* size of the original screenshots, used to place the clickable spots */
  /* Behaves like GNOME Shell: Activities toggles the overview, the dock's Show Apps button toggles the app grid, Esc closes. */
  var DESKTOP = 0, APPS = 1, WINDOWS = 2;
  var activities = function (y: number) { return { x: 32, y: 16, w: 64, h: 28, label: 'Activities', tip: 'left', to: y }; };
  var showApps = function (to: number) { return { x: 1037, y: 944, w: 70, h: 70, label: 'Show Apps', tip: 'above', to: to }; };
  var screens = [
    { src: 'shots/screen-1-desktop.jpg', name: 'Desktop',
      alt: 'Lumora desktop with a yellow palace wallpaper, a top bar and a dock at the bottom',
      cap: 'The Lumora desktop. Click Activities in the top left to see your open windows, or the leaf in the dock to show all apps.',
      hot: [ activities(WINDOWS), showApps(APPS) ] },
    { src: 'shots/screen-2-launcher.jpg', name: 'App grid',
      alt: 'The Lumora app grid showing folders and apps over a blurred wallpaper',
      cap: 'The app grid. Click the leaf again to go back to your open windows, or Activities to return to the desktop. Esc works too.',
      hot: [ activities(DESKTOP), showApps(WINDOWS) ] },
    { src: 'shots/screen-3-windows.jpg', name: 'Open windows',
      alt: 'The Lumora windows overview showing the open desktop as a large preview',
      cap: 'Your open windows. Click the window to open it, the leaf to show all apps, or Activities to return to the desktop. Esc works too.',
      hot: [ activities(DESKTOP), showApps(APPS),
             { x: 888, y: 486, w: 1394, h: 760, label: 'Open this window', tip: 'center', quiet: true, to: DESKTOP } ] }
  ];
  var stage = document.getElementById('stage'), img: HTMLImageElement | null = document.getElementById('shot'),
      cap = document.getElementById('shotcap'), steps = document.getElementById('steps');
  var current = DESKTOP;
  screens.forEach(function (sc) { var pre = new Image(); pre.src = sc.src; });

  screens.forEach(function (sc, i) {
    if(!steps) return;
    var b = document.createElement('button');
    b.type = 'button'; b.textContent = sc.name;
    b.addEventListener('click', function () { show(i); });
    if (astroAttr) {
      b.setAttribute(astroAttr, '');
    }
    steps.appendChild(b);
  });

  function show(i) {
    if(!stage) return;
    if(!img) return;
    if(!cap) return;
    current = i;
    var sc = screens[i];
    Array.prototype.forEach.call(stage.querySelectorAll('.hot'), function (h) { h.remove(); });
    img.src = sc.src; img.alt = sc.alt;
    cap.textContent = sc.cap;
    sc.hot.forEach(function (h) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'hot ' + (h.tip || '') + (h.quiet ? ' quiet' : '');
      b.style.left = (h.x / W * 100) + '%';
      b.style.top = (h.y / H * 100) + '%';
      b.style.width = 'max(' + (h.w / W * 100) + '%, 44px)';
      b.style.height = 'max(' + (h.h / H * 100) + '%, 36px)';
      b.setAttribute('aria-label', h.label);
      b.addEventListener('click', function () { show(h.to); });
      if (astroAttr) {
        b.setAttribute(astroAttr, '');
        b.innerHTML = `<span class="tip" ${astroAttr}> ${h.label} </span>`;
      }
      stage.appendChild(b);
    });
    Array.prototype.forEach.call(steps.children, function (b, k) { b.setAttribute('aria-current', k === i ? 'true' : 'false'); });
  }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && current !== DESKTOP) show(DESKTOP);
  });
  show(DESKTOP);
})();
</script>